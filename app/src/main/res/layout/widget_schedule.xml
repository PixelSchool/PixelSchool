<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- Header with Day Navigation & Flipping -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Prev Day Button -->
        <ImageView
            android:id="@+id/widget_btn_prev_day"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_bg"
            android:src="@drawable/ic_widget_chevron_left"
            android:scaleType="centerInside"
            android:contentDescription="Предыдущий день" />

        <!-- Day Title & Date (Click resets to Today) -->
        <LinearLayout
            android:id="@+id/widget_header_center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp">

            <TextView
                android:id="@+id/widget_header_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сегодня"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_header_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Next Day Button -->
        <ImageView
            android:id="@+id/widget_btn_next_day"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_bg"
            android:src="@drawable/ic_widget_chevron_right"
            android:scaleType="centerInside"
            android:layout_marginRight="6dp"
            android:contentDescription="Следующий день" />

        <!-- Count / App badge -->
        <TextView
            android:id="@+id/widget_header_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:text="PixelSchool"
            android:textColor="@color/widget_primary_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Subtle divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_divider" />

    <!-- Empty / Weekend State -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌴"
            android:textSize="28sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выходной день"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Можно отдохнуть и набраться сил перед учёбой"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Scrollable ListView of Lessons -->
    <ListView
        android:id="@+id/widget_lessons_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

</LinearLayout>
